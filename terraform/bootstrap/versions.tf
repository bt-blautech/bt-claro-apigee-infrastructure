terraform {
  required_version = ">= 1.6.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    http = {
      source  = "hashicorp/http"
      version = "~> 3.4"
    }
  }
  # Estado SEPARADO del de la configuracion (terraform/): la org cambia muy poco
  # y no debe destruirse por accidente al trabajar con ambientes o target servers.
  backend "gcs" {
    prefix = "apigee-bootstrap"
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
